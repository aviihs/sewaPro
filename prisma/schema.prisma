// SewaPro database schema.
// Connection URL lives in prisma.config.ts (Prisma 7).
// Tables and columns are snake_case in the database (raw SQL stays readable).
// Constraints Prisma cannot express (exclusion, CHECK) live in hand-written
// migration SQL; see docs/DECISIONS.md (D-021..D-026).

generator client {
  provider            = "prisma-client"
  output              = "../src/infrastructure/prisma/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum OtpPurpose {
  LOGIN
}

enum ProviderVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum DocumentType {
  CITIZENSHIP
  NATIONAL_ID
  PASSPORT
  DRIVING_LICENSE
  PAN_CERTIFICATE
  SKILL_CERTIFICATE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PricingType {
  FIXED
  HOURLY
  STARTING_FROM
  QUOTATION
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  DISPUTED
}

enum ActorRole {
  CUSTOMER
  PROVIDER
  ADMIN
  SYSTEM
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  BOOKING_STATUS_CHANGED
  BOOKING_COMPLETED
  QUOTATION_SENT
  QUOTATION_RESPONDED
  REVIEW_RECEIVED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  PROVIDER_VERIFIED
  PROVIDER_REJECTED
  PROVIDER_SUSPENDED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

enum DisputeOutcome {
  BOOKING_COMPLETED
  BOOKING_CANCELLED
}

// ─── Identity ─────────────────────────────────────────────────

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  role            UserRole
  status          UserStatus @default(ACTIVE)
  fullName        String     @map("full_name") @db.VarChar(100)
  email           String?    @unique @db.VarChar(254)
  phone           String     @unique @db.VarChar(16)
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  refreshTokens    RefreshToken[]
  addresses        Address[]
  provider         Provider?
  bookings         Booking[]      @relation("CustomerBookings")
  reviews          Review[]       @relation("CustomerReviews")
  notifications    Notification[]
  disputesRaised   Dispute[]      @relation("DisputeRaisedBy")
  disputesResolved Dispute[]      @relation("DisputeResolvedBy")
  auditLogs        AuditLog[]
  hiddenReviews    Review[]       @relation("ReviewHiddenBy")

  @@index([role, status, createdAt])
  @@index([createdAt])
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_full_name_trgm_idx")
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  familyId     String    @map("family_id") @db.Uuid
  device       String?   @db.VarChar(255)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpCode {
  id         String     @id @default(uuid(7)) @db.Uuid
  phone      String     @db.VarChar(16)
  purpose    OtpPurpose
  codeHash   String     @map("code_hash") @db.VarChar(64)
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, purpose, createdAt])
  @@map("otp_codes")
}

model Address {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String   @db.VarChar(50)
  line1     String   @db.VarChar(200)
  area      String?  @db.VarChar(100)
  city      String   @db.VarChar(100)
  district  String?  @db.VarChar(100)
  landmark  String?  @db.VarChar(200)
  latitude  Float    @db.DoublePrecision
  longitude Float    @db.DoublePrecision
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([userId], map: "addresses_one_default_per_user", where: raw("is_default"))
  @@index([userId, createdAt])
  @@map("addresses")
}

// ─── Catalog ──────────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(80)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(500)
  iconUrl     String?   @map("icon_url") @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  services Service[]

  @@unique([name], map: "categories_name_live_key", where: raw("deleted_at IS NULL"))
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Service {
  id          String    @id @default(uuid(7)) @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?   @db.VarChar(500)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  providerServices ProviderService[]
  bookings         Booking[]

  @@unique([categoryId, name], map: "services_category_name_live_key", where: raw("deleted_at IS NULL"))
  @@index([categoryId, isActive])
  @@map("services")
}

// ─── Providers ────────────────────────────────────────────────

model Provider {
  id                 String                     @id @default(uuid(7)) @db.Uuid
  userId             String                     @unique @map("user_id") @db.Uuid
  businessName       String?                    @map("business_name") @db.VarChar(120)
  bio                String?                    @db.VarChar(1000)
  experienceYears    Int                        @default(0) @map("experience_years")
  verificationStatus ProviderVerificationStatus @default(PENDING_VERIFICATION) @map("verification_status")
  rejectionReason    String?                    @map("rejection_reason") @db.VarChar(500)
  submittedAt        DateTime?                  @map("submitted_at") @db.Timestamptz(3)
  verifiedAt         DateTime?                  @map("verified_at") @db.Timestamptz(3)
  latitude           Float                      @db.DoublePrecision
  longitude          Float                      @db.DoublePrecision
  serviceRadiusKm    Int                        @default(10) @map("service_radius_km")
  ratingAverage      Decimal                    @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount        Int                        @default(0) @map("rating_count")
  completedJobs      Int                        @default(0) @map("completed_jobs")
  isAvailable        Boolean                    @default(true) @map("is_available")
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?                  @map("deleted_at") @db.Timestamptz(3)

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  documents         ProviderDocument[]
  services          ProviderService[]
  portfolioImages   PortfolioImage[]
  availabilityRules AvailabilityRule[]
  blockedDates      BlockedDate[]
  settings          ProviderSettings?
  bookings          Booking[]
  quotations        Quotation[]
  reviews           Review[]

  @@index([verificationStatus, createdAt])
  @@index([verificationStatus, submittedAt])
  @@index([verificationStatus, isAvailable, ratingAverage])
  @@index([businessName(ops: raw("gin_trgm_ops"))], type: Gin, map: "providers_business_name_trgm_idx")
  @@map("providers")
}

model ProviderDocument {
  id           String         @id @default(uuid(7)) @db.Uuid
  providerId   String         @map("provider_id") @db.Uuid
  type         DocumentType
  storageKey   String         @unique @map("storage_key") @db.VarChar(255)
  mimeType     String         @map("mime_type") @db.VarChar(100)
  sizeBytes    Int            @map("size_bytes")
  originalName String?        @map("original_name") @db.VarChar(255)
  status       DocumentStatus @default(PENDING)
  reviewNote   String?        @map("review_note") @db.VarChar(500)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
  @@map("provider_documents")
}

model ProviderService {
  id          String      @id @default(uuid(7)) @db.Uuid
  providerId  String      @map("provider_id") @db.Uuid
  serviceId   String      @map("service_id") @db.Uuid
  pricingType PricingType @map("pricing_type")
  price       Decimal?    @db.Decimal(12, 2)
  description String?     @db.VarChar(500)
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([providerId, serviceId])
  @@index([serviceId, isActive, price])
  @@map("provider_services")
}

model PortfolioImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  storageKey String   @unique @map("storage_key") @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(100)
  sizeBytes  Int      @map("size_bytes")
  caption    String?  @db.VarChar(200)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, sortOrder])
  @@map("portfolio_images")
}

/// Weekly working window in Nepal local time, minutes from midnight.
model AvailabilityRule {
  id          String   @id @default(uuid(7)) @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  dayOfWeek   Int      @map("day_of_week") @db.SmallInt
  startMinute Int      @map("start_minute") @db.SmallInt
  endMinute   Int      @map("end_minute") @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, dayOfWeek])
  @@map("availability_rules")
}

model BlockedDate {
  id         String   @id @default(uuid(7)) @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  date       DateTime @db.Date
  reason     String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, date])
  @@map("blocked_dates")
}

model ProviderSettings {
  providerId       String   @id @map("provider_id") @db.Uuid
  maxDailyBookings Int      @default(5) @map("max_daily_bookings") @db.SmallInt
  slotMinutes      Int      @default(60) @map("slot_minutes") @db.SmallInt
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_settings")
}

// ─── Bookings ─────────────────────────────────────────────────

model Booking {
  id                 String        @id @default(uuid(7)) @db.Uuid
  customerId         String        @map("customer_id") @db.Uuid
  providerId         String        @map("provider_id") @db.Uuid
  serviceId          String        @map("service_id") @db.Uuid
  addressId          String?       @map("address_id") @db.Uuid
  status             BookingStatus @default(PENDING)
  scheduledAt        DateTime      @map("scheduled_at") @db.Timestamptz(3)
  scheduledEndAt     DateTime      @map("scheduled_end_at") @db.Timestamptz(3)
  problemDescription String?       @map("problem_description") @db.VarChar(2000)
  pricingType        PricingType   @map("pricing_type")
  quotedPrice        Decimal?      @map("quoted_price") @db.Decimal(12, 2)
  estimatedAmount    Decimal?      @map("estimated_amount") @db.Decimal(12, 2)
  finalAmount        Decimal?      @map("final_amount") @db.Decimal(12, 2)
  addressLine1       String        @map("address_line1") @db.VarChar(200)
  addressArea        String?       @map("address_area") @db.VarChar(100)
  addressCity        String        @map("address_city") @db.VarChar(100)
  addressLandmark    String?       @map("address_landmark") @db.VarChar(200)
  addressLatitude    Float         @map("address_latitude") @db.DoublePrecision
  addressLongitude   Float         @map("address_longitude") @db.DoublePrecision
  cancelReason       String?       @map("cancel_reason") @db.VarChar(500)
  rejectionReason    String?       @map("rejection_reason") @db.VarChar(500)
  idempotencyKey     String?       @map("idempotency_key") @db.VarChar(64)
  acceptedAt         DateTime?     @map("accepted_at") @db.Timestamptz(3)
  startedAt          DateTime?     @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?     @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer      User                   @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  provider      Provider               @relation(fields: [providerId], references: [id], onDelete: Restrict)
  service       Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  address       Address?               @relation(fields: [addressId], references: [id], onDelete: SetNull)
  images        BookingImage[]
  statusHistory BookingStatusHistory[]
  quotations    Quotation[]
  review        Review?
  disputes      Dispute[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
  @@index([customerId, scheduledAt])
  @@index([providerId, status, scheduledAt])
  @@index([providerId, scheduledAt])
  @@index([status, createdAt])
  @@index([status, scheduledAt])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("bookings")
}

model BookingImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  bookingId  String   @map("booking_id") @db.Uuid
  storageKey String   @unique @map("storage_key") @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(100)
  sizeBytes  Int      @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_images")
}

model BookingStatusHistory {
  id         String         @id @default(uuid(7)) @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  actorId    String?        @map("actor_id") @db.Uuid
  actorRole  ActorRole      @map("actor_role")
  note       String?        @db.VarChar(500)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model Quotation {
  id           String          @id @default(uuid(7)) @db.Uuid
  bookingId    String          @map("booking_id") @db.Uuid
  providerId   String          @map("provider_id") @db.Uuid
  labourCost   Decimal         @map("labour_cost") @db.Decimal(12, 2)
  materialCost Decimal         @map("material_cost") @db.Decimal(12, 2)
  total        Decimal         @db.Decimal(12, 2)
  note         String?         @db.VarChar(1000)
  status       QuotationStatus @default(DRAFT)
  expiresAt    DateTime        @map("expires_at") @db.Timestamptz(3)
  sentAt       DateTime?       @map("sent_at") @db.Timestamptz(3)
  respondedAt  DateTime?       @map("responded_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([bookingId], map: "quotations_one_open_per_booking", where: raw("status = 'DRAFT' OR status = 'SENT'"))
  @@index([bookingId, createdAt])
  @@index([status, expiresAt])
  @@map("quotations")
}

// ─── Reviews, notifications, disputes, audit ─────────────────

model Review {
  id              String    @id @default(uuid(7)) @db.Uuid
  bookingId       String    @unique @map("booking_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  providerId      String    @map("provider_id") @db.Uuid
  overall         Int       @db.SmallInt
  serviceQuality  Int       @map("service_quality") @db.SmallInt
  professionalism Int       @db.SmallInt
  punctuality     Int       @db.SmallInt
  communication   Int       @db.SmallInt
  comment         String?   @db.VarChar(2000)
  hiddenAt        DateTime? @map("hidden_at") @db.Timestamptz(3)
  hiddenById      String?   @map("hidden_by_id") @db.Uuid
  hiddenReason    String?   @map("hidden_reason") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customer User     @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Restrict)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  hiddenBy User?    @relation("ReviewHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)

  @@index([providerId, createdAt])
  @@index([createdAt])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(150)
  body      String           @db.VarChar(1000)
  data      Json?
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId], map: "notifications_unread_idx", where: raw("read_at IS NULL"))
  @@map("notifications")
}

model Dispute {
  id           String          @id @default(uuid(7)) @db.Uuid
  bookingId    String          @map("booking_id") @db.Uuid
  raisedById   String          @map("raised_by_id") @db.Uuid
  raisedByRole ActorRole       @map("raised_by_role")
  reason       String          @db.VarChar(200)
  description  String          @db.VarChar(2000)
  status       DisputeStatus   @default(OPEN)
  outcome      DisputeOutcome?
  resolution   String?         @db.VarChar(2000)
  resolvedById String?         @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?       @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  raisedBy   User    @relation("DisputeRaisedBy", fields: [raisedById], references: [id], onDelete: Restrict)
  resolvedBy User?   @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([bookingId], map: "disputes_one_open_per_booking", where: raw("status <> 'RESOLVED'"))
  @@index([status, createdAt])
  @@index([bookingId])
  @@map("disputes")
}

model AuditLog {
  id         String     @id @default(uuid(7)) @db.Uuid
  actorId    String?    @map("actor_id") @db.Uuid
  actorRole  ActorRole? @map("actor_role")
  action     String     @db.VarChar(100)
  entityType String     @map("entity_type") @db.VarChar(50)
  entityId   String?    @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ipAddress  String?    @map("ip_address") @db.VarChar(45)
  userAgent  String?    @map("user_agent") @db.VarChar(255)
  requestId  String?    @map("request_id") @db.VarChar(64)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
