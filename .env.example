# ─── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# true when running behind a reverse proxy / load balancer (needed for correct client IPs)
TRUST_PROXY=false

# ─── Database (PostgreSQL 16+, PostGIS required from Step 6) ─
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sewapro
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# ─── HTTP ────────────────────────────────────────────────────
# Comma-separated allow-list. Required in production.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ─── Logging ─────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
LOG_PRETTY=true

# ─── Rate limiting (global default; sensitive routes are stricter) ──
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ─── Swagger (/docs, /docs-json) ─────────────────────────────
# Always on outside production. In production it is off unless SWAGGER_ENABLED=true,
# and then HTTP Basic credentials are mandatory.
SWAGGER_ENABLED=false
SWAGGER_USER=
SWAGGER_PASSWORD=

# ─── Sensitive routes (login, register, codes, password reset): per-IP limit ───
SENSITIVE_THROTTLE_TTL_MS=60000
SENSITIVE_THROTTLE_LIMIT=10

# ─── Auth (generate secrets with: openssl rand -base64 48) ───
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# HMAC pepper for OTP hashes
OTP_PEPPER=

# ─── Email (verification and password reset codes) ──────────
# console: codes are written to the log (development only; refused in production)
# resend:  real delivery through https://resend.com (needs RESEND_API_KEY and EMAIL_FROM)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=SewaPro <no-reply@your-domain.com>

# ─── File storage (local disk adapter) ───────────────────────
PUBLIC_BASE_URL=http://localhost:3000
STORAGE_DIR=./storage
STORAGE_SIGNING_SECRET=
SIGNED_URL_TTL_SECONDS=300

# ─── Seed (bun run db:seed). Never commit real values. ───────
SEED_ADMIN_EMAIL=admin@sewapro.local
SEED_ADMIN_PHONE=+9779800000000
SEED_ADMIN_PASSWORD=
# Password for sample providers/customers; leave empty to skip sample data
SEED_SAMPLE_PASSWORD=
